# 이 파일을 복사해 .env로 저장하고 값을 채우세요. .env는 git에 커밋되지 않습니다.

# 로그인하지 않은 계정도 쓸 수 있는 기본 Finnhub API 키 (선택 사항)
FINNHUB_API_KEY=

# 세션 서명 키. 비워두면 서버가 최초 실행 시 자동 생성해 이 파일에 기록합니다.
SECRET_KEY=

# PostgreSQL로 전환 시 설정 (미설정 시 SQLite 사용)
# DATABASE_URL=postgresql://user:pw@host/dbname

# HTTPS 배포 환경에서만 true로 설정하세요 (로컬 http 개발에서는 false)
# COOKIE_SECURE=false

# 스위퍼 전략 매매 알림 메일 발송용 Resend(https://resend.com) API 설정 (선택 사항 -
# 비워두면 알림 기능만 조용히 꺼진 채로 나머지는 정상 동작합니다). Render 컨테이너에서는
# SMTP 아웃바운드 포트가 막혀 있어 HTTP API 방식(Resend)을 씁니다. resend.com 가입 후
# API Keys에서 발급한 키를 RESEND_API_KEY에 넣으세요.
RESEND_API_KEY=
# 비워두면 Resend가 도메인 인증 없이 제공하는 onboarding@resend.dev를 씁니다.
# 본인 도메인을 Resend에 인증했다면 그 도메인의 주소로 바꿔도 됩니다.
RESEND_FROM=

# Render 등 클라우드에 배포할 때는 이 .env 대신 호스팅 플랫폼의 환경변수 설정
# 화면에서 위 값들을 등록하세요 (render.yaml 참고). 로컬 개발에서만 이 파일을 씁니다.
